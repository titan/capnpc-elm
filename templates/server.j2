module {{ full_module_name }}.Server exposing
    ( interfaceId
    , Handlers
    , makeDispatcher
    )

import Capnproto
import Rpc.Client as Rpc
{% for imp in imports %}
import {{ imp }}{% endfor %}


interfaceId : Capnproto.Word64
interfaceId =
    Capnproto.toWord64 {{ interface_high }} {{ interface_low }}

{% for method in methods %}
{% if loop.first %}type alias Handlers msg =
    { {{ method.name }}
{% else %}    , {{ method.name }}
{% endif %}        : {{ method.param_module }}.Entity
        -> ({{ method.result_module }}.Entity -> Cmd msg)
        -> msg
{% endfor %}
    }


makeDispatcher : Handlers msg -> Rpc.ServerHandler msg
makeDispatcher handlers methodId payloadReader caps replyFn =
    case methodId of
{% for method in methods %}
        {{ method.id }} ->
            case {{ method.param_module }}.decode {% if method.param_has_caps %}caps {% endif %}payloadReader of
                Ok params ->
                    Ok (handlers.{{ method.name }} params (\results -> replyFn.send ({{ method.result_module }}.encode results)))

                Err err ->
                    Err ("Failed to decode params for {{ method.name }}: " ++ err)

{% endfor %}
        _ ->
            Err ("Unknown method: " ++ String.fromInt methodId)



{- Default dispatcher: answers with `replyFn.send` (releaseParamCaps = true,
i.e. parameter capabilities are released when the Return is sent).

A handler that KEEPS a parameter capability (e.g. stores a listener for later
calls) must answer with `replyFn.sendRetainingCaps` and release the reference
later via `Rpc.releaseCapability`. `makeDispatcher` cannot express that —
write a custom `Rpc.ServerHandler` (combine it with `Rpc.export`) instead.
-}
